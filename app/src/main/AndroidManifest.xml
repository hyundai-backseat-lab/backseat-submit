<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량 신호를 읽는 권한(읽기만). 공모전 개발 단계에서는 선언만으로 사용 가능 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 계기판 경고등(비상등·주차 브레이크·경고)의 변경 알림 등록에 SDK가 요구한다. 실제 부여 여부는 에뮬레이터 실측 -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- 내비 도착 이벤트(NaviHelper). 문서의 내비 권한 중 경로 정보에 해당하는 것 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 음성 합성·인식(ON_DEVICE)과 점검용 녹음 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 장소 검색 중계 API 호출(F-16) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 위치로 앞 장소 찾기(F-11). 정확한 위치(FINE)를 허용해야 동의로 본다 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BackseatPlayground">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BackseatPlayground">
            <!-- 주행 중에도 띄워도 되는 화면이라는 선언. 주행 중 화면은 요약 패널만 보이고 버튼이 없다(F-06) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
